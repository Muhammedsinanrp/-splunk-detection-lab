# ==============================================================================
# Detection Rule: Credential Dumping via LSASS Memory Access (Mimikatz / ProcDump)
# MITRE ATT&CK: T1003.001 (OS Credential Dumping: LSASS Memory)
# Severity: Critical | Tactic: Credential Access
# Target Data Sources: Microsoft Sysmon Operational Log (EventCode 10 - ProcessAccess)
# ==============================================================================

# --- Description ---
# Threat actors dump credentials (NTLM hashes, plaintext passwords, Kerberos tickets) 
# by reading the memory space of Local Security Authority Subsystem Service (`lsass.exe`).
# Sysmon Event ID 10 logs process handle creation. This rule filters for suspicious GrantedAccess 
# rights (e.g., 0x1010 [PROCESS_QUERY_LIMITED_INFORMATION | PROCESS_VM_READ] or 0x1F0FFF [PROCESS_ALL_ACCESS])
# requested against `lsass.exe` by untrusted/non-system executables.

# --- Splunk Query (SPL) ---
index=sysmon (sourcetype="XmlWinEventLog:Microsoft-Windows-Sysmon/Operational" OR sourcetype="WinEventLog:Microsoft-Windows-Sysmon/Operational")
EventCode=10
| where like(lower(TargetImage), "%\\lsass.exe")
| search NOT SourceImage IN (
    "*\\system32\\csrss.exe", 
    "*\\system32\\services.exe", 
    "*\\system32\\lsass.exe", 
    "*\\system32\\svchost.exe",
    "*\\Windows Defender\\MsMpEng.exe",
    "*\\Splunk\\bin\\splunk-powershell.exe"
)
| eval Access_Mask = coalesce(GrantedAccess, "Unknown")
| eval Source_Process = coalesce(SourceImage, Image)
| eval Source_User = coalesce(SourceUser, User)
| table _time, Computer, Source_User, Source_Process, TargetImage, Access_Mask, CallTrace
| rename Computer as "Endpoint", Source_Process as "Attacking Tool", Access_Mask as "Requested Rights"

# --- False Positives & Tuning ---
# 1. Antivirus / Endpoint Detection & Response (EDR) agents scanning memory.
#    Mitigation: Whitelist legitimate security tools signed binaries by vendor path and hash.
# 2. Microsoft Process Explorer / Task Manager when opened as administrator.
